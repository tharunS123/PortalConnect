{
  "name": "portal-connect",
  "version": "1.0.0",
  "description": "PortalConnect \u2014 role-based user and customer management portal (Angular 22 + Express 5).",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "npm run dev --workspace server",
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:start\" \"npm:start:api\"",
    "build": "ng build",
    "build:api": "npm run build --workspace server",
    "build:all": "npm run build && npm run build:api",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --no-watch --coverage",
    "test:api": "npm run test --workspace server",
    "test:all": "npm run test && npm run test:api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && npm run typecheck --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "serve:prod": "npm run start --workspace server",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:api"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
