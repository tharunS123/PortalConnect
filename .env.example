# ---------------------------------------------------------------------------
# PortalConnect API configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Absolute or relative path to the SQLite database file.
DATABASE_PATH=./server/data/portalconnect.db

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production, must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret-at-least-32-chars

# Token lifetimes (vercel/ms format).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

# Requests allowed per IP per window on /api/auth/* routes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# bcrypt cost factor. 12 is a reasonable production default.
BCRYPT_ROUNDS=12

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Directory containing the built Angular app; served by the API in production.
STATIC_DIR=./dist/portal-connect/browser

# ---------------------------------------------------------------------------
# Seed data — only used by `npm run db:seed`.
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@portalconnect.local
SEED_ADMIN_PASSWORD=ChangeMe123!
